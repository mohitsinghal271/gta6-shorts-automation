# GTA 6 AI YouTube Shorts Automation Agent - Environment Configuration

# Paths & Binaries
FFMPEG_PATH=
INPUT_DIR=
OUTPUT_DIR=

# YouTube Data API v3 Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_PICKLE_FILE=token.pickle
YOUTUBE_SIMULATE_UPLOAD=true
YOUTUBE_DEFAULT_PRIVACY=private

# AI / TTS Settings
DEFAULT_LANGUAGE=hinglish
EDGE_TTS_VOICE_HINDI=hi-IN-MadhurNeural
EDGE_TTS_VOICE_ENGLISH=en-US-ChristopherNeural
EDGE_TTS_VOICE_HINGLISH=hi-IN-MadhurNeural
INCLUDE_VOICEOVER=true

# Game Preset (GTA 6, GTA 5, RDR2, Minecraft)
CURRENT_GAME=GTA 6
